  m_Script: {fileID: 11500000, guid: d181c03df4d514477af7af4667bb6e22, type: 3}
  m_Name: TutorialConfig
  m_EditorClassIdentifier: Assembly-CSharp::TutorialConfig
  bodyFont: {fileID: 11400000, guid: a5e325fc73a121645b8bb045804e62a4, type: 2}
  overlayPrefab: {fileID: 4634822672165253103, guid: 7f288b02607aa48329b0d17e2740491f, type: 3}
  steps:
  - order: 1
    id: open_player
    bodyText: "<b>\uB808\uB4DC\uBE0C\uB9AC\uCC98</b>\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uD658\uC601\uD569\uB2C8\uB2E4! \uBA3C\uC800 <b>\uBB34\uAE30\uC640 \uB4DC\uB860\uC744
      \uAD50\uCCB4\uD558\uB294 \uBC29\uBC95</b>\uBD80\uD130 \uC54C\uC544\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      <b>\uAE30\uCCB4 \uD0ED</b>\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Player_Btn
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: open_player
    bodyText: "\uC6B0\uCE21\uC758 <b>\uC8FC\uBB34\uC7A5 \uC544\uC774\uCF58</b>\uC744
      \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Weapon_Image_Button
    advanceType: 1
    eventType: 0
    targetAmount: 6
    targetId: 
  - order: 3
    id: open_player
    bodyText: "\uBB34\uAE30 <b>'\uD3EC\uD0C4'</b>\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    highlightTargetName: LoadoutOptionButton(Clone)
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 4
    id: open_player
    bodyText: "\uBB34\uAE30\uB97C \uACE0\uB978 \uB4A4 <b>\uC7A5\uCC29\uD558\uAE30
      \uBC84\uD2BC</b>\uAE4C\uC9C0 \uB20C\uB7EC\uC57C \uC7A5\uCC29\uC774 \uC644\uB8CC\uB429\uB2C8\uB2E4."
    highlightTargetName: Equip_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 5
    id: open_player
    bodyText: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4! \uC774\uBC88\uC5D4 \uAE30\uCCB4
      \uD0ED\uC744 \uC0B4\uD3B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC7A5\uCC29\uD55C
      \uBB34\uAE30\uC640 \uB4DC\uB860\uC758 \uC2A4\uD0EF\uC740 \uC544\uB798 \uD328\uB110\uC5D0
      \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    highlightTargetName: Weapon/Drone Infos_BG_Frame
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 6
    id: open_player
    bodyText: "\uC704\uCABD \uBC84\uD2BC\uC73C\uB85C <b>\uBB34\uAE30\uC640 \uB4DC\uB860\uC758
      \uC2A4\uD0EF\uC744 \uBC88\uAC08\uC544</b> \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: InfoButtons Group
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 7
    id: open_player
    bodyText: "\uD0D1\uC2B9 \uC911\uC778 <b>\uD0F1\uD06C\uC758 \uC2A4\uD0EF</b>\uC785\uB2C8\uB2E4.
      \uB2A5\uB825\uCE58\uC640 \uD604\uC7AC \uD0F1\uD06C \uB808\uBCA8\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Player nfos_BG_Frame
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 8
    id: open_player
    bodyText: "<b>\uD654\uC0B4\uD45C \uBC84\uD2BC</b>\uC744 \uB204\uB974\uBA74 <b>\uB354
      \uC0C1\uC138\uD55C \uC815\uBCF4</b>\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: RouteDetailButton
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 9
    id: open_player
    bodyText: "<b>\uB4DC\uB860</b>\uC785\uB2C8\uB2E4. \uD0F1\uD06C\uB97C <b>\uC5C4\uD638</b>\uD558\uBA70
      <b>\uBCF4\uC870 \uD654\uB825</b>\uC744 \uB354\uD574 \uC90D\uB2C8\uB2E4."
    highlightTargetName: Drone_Image_Button
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 10
    id: open_player
    bodyText: "<b>\uB4DC\uB860 \uC544\uC774\uCF58</b>\uC744 \uB20C\uB7EC \uC0B4\uD3B4\uBCF4\uC138\uC694."
    highlightTargetName: Drone_Image_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 11
    id: open_player
    bodyText: "\uB4DC\uB860 \uC778\uBCA4\uD1A0\uB9AC\uC785\uB2C8\uB2E4. \uC9C0\uAE08\uC740
      1\uAE30\uBFD0\uC774\uC9C0\uB9CC, \uC0C8\uB85C\uC6B4 \uB4DC\uB860\uC774 \uD574\uAE08\uB418\uBA74
      \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Viewport
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 12
    id: open_player
    bodyText: "<b>\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC</b>\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 13
    id: open_player
    bodyText: "\uD50C\uB808\uC774\uC5B4\uC758 \uB2A5\uB825\uCE58\uB97C \uD558\uB098\uB85C
      \uD569\uCE5C <b>\uC885\uD569 \uC804\uD22C\uB825</b>\uC785\uB2C8\uB2E4."
    highlightTargetName: PlayerPower_txt
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 14
    id: open_player
    bodyText: "\uC2A4\uD0AC\uC744 \uC81C\uC678\uD55C <b>\uD0F1\uD06C + \uB4DC\uB860
      + \uBB34\uAE30</b>\uC758 \uB2A5\uB825\uCE58\uB97C \uD569\uC0B0\uD55C \uAC12\uC785\uB2C8\uB2E4."
    highlightTargetName: PlayerPower_txt
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 15
    id: open_player
    bodyText: "\uAE30\uCCB4 \uD0ED \uC124\uBA85\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4.
      \uC774\uC5B4\uC11C <b>\uC778\uAC8C\uC784 UI</b>\uB97C \uC0B4\uD3B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 16
    id: open_player
    bodyText: "<b>\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC</b>\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 17
    id: open_player
    bodyText: "\uD0F1\uD06C\uC758 <b>\uB808\uBCA8\uACFC \uB0B4\uAD6C\uB3C4(HP)</b>\uB97C
      \uBCF4\uC5EC\uC8FC\uB294 \uC0C1\uD0DC\uCC3D\uC785\uB2C8\uB2E4."
    highlightTargetName: UserStatus_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 18
    id: open_player
    bodyText: "\uB0B4\uAD6C\uB3C4\uAC00 <b>0\uC774 \uB418\uBA74 \uC804\uCC28\uAC00
      \uD30C\uAD34</b>\uB418\uACE0, <b>3\uCD08 \uB4A4 \uC790\uB3D9\uC73C\uB85C \uC7AC\uBC30\uCE58</b>\uB429\uB2C8\uB2E4."
    highlightTargetName: UserStatus_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 19
    id: open_player
    bodyText: "\uD50C\uB808\uC774\uC5B4\uC758 \uC131\uC7A5\uC744 \uB3D5\uB294 <b>\uAC00\uC774\uB4DC
      \uC784\uBB34</b>\uC785\uB2C8\uB2E4. \uBAA9\uD45C\uB97C \uB2EC\uC131\uD558\uBA74
      \uC7AC\uD654\uB97C \uBCF4\uC0C1\uC73C\uB85C \uC9C0\uAE09\uD569\uB2C8\uB2E4."
    highlightTargetName: GuideMissionBar
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 20
    id: open_player
    bodyText: "\uACF5\uC6A9 \uD654\uD3D0 <color=#EED96B><b>\uD06C\uB808\uB527</b></color>\uC785\uB2C8\uB2E4.
      \uC2DC\uC124\uACFC \uD0F1\uD06C\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
      \uB54C \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    highlightTargetName: Credit
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 21
    id: open_player
    bodyText: "<b>\uC801 \uCC98\uCE58, \uAC00\uC774\uB4DC \uC784\uBB34 \uB2EC\uC131,
      \uC790\uC6D0 \uC815\uC81C\uC18C \uC218\uAE09</b> \uB4F1 \uB2E4\uC591\uD55C
      \uBC29\uBC95\uC73C\uB85C \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Credit
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 22
    id: open_player
    bodyText: "\uD76C\uADC0 \uC790\uC6D0 <color=#60C6DE><b>\uCF54\uC5B4 \uD06C\uB9AC\uC2A4\uD0C8</b></color>\uC785\uB2C8\uB2E4.
      \uC0C1\uC810\uC5D0\uC11C \uBB34\uAE30\uC640 \uC2A4\uD0AC\uC744 \uBF51\uC744
      \uB54C \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    highlightTargetName: Core Crystal
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 23
    id: open_player
    bodyText: "<b>\uBCF4\uC2A4 \uCC98\uCE58</b>\uB098 <b>\uB3C4\uC804\uACFC\uC81C
      \uC644\uB8CC</b>\uB85C \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Core Crystal
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 24
    id: open_player
    bodyText: "<b>\uC2A4\uD0AC \uD45C\uC2DC\uCC3D</b>\uC785\uB2C8\uB2E4. \uC2A4\uD0AC\uC744
      \uBCF4\uC720\uD558\uBA74 \uD558\uB2E8\uC5D0 \uC544\uC774\uCF58\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
    highlightTargetName: SkillCooldown
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 25
    id: open_player
    bodyText: "<b>\uCFE8\uD0C0\uC784</b>\uC774 0\uC774 \uB418\uBA74 \uC2A4\uD0AC\uC774
      \uC790\uB3D9\uC73C\uB85C \uBC1C\uB3D9\uB429\uB2C8\uB2E4."
    highlightTargetName: SkillCooldown
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 26
    id: open_player
    bodyText: "\uD604\uC7AC <b>\uC2A4\uD14C\uC774\uC9C0</b>\uB97C \uBCF4\uC5EC\uC8FC\uB294
      \uCC3D\uC785\uB2C8\uB2E4."
    highlightTargetName: Stage_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 27
    id: open_player
    bodyText: "<b>\uD55C \uC2A4\uD14C\uC774\uC9C0\uB294 \uC5EC\uB7EC \uB77C\uC6B4\uB4DC</b>\uB85C
      \uC774\uB8E8\uC5B4\uC9C0\uBA70, \uB77C\uC6B4\uB4DC\uB97C \uBAA8\uB450 \uB9C8\uCE58\uBA74
      \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    highlightTargetName: Stage_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 28
    id: open_player
    bodyText: "\uC2A4\uD14C\uC774\uC9C0\uAC00 \uC624\uB97C\uC218\uB85D <b>\uBCF4\uC0C1\uC774
      \uCEE4\uC9C0\uACE0 \uB354 \uAC15\uD55C \uC801</b>\uC774 \uB4F1\uC7A5\uD569\uB2C8\uB2E4."
    highlightTargetName: Stage_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 29
    id: open_player
    bodyText: "<b>\uBCF4\uC2A4\uB97C \uC18C\uD658</b>\uD558\uB294 \uBC84\uD2BC\uC785\uB2C8\uB2E4.
      \uB204\uB974\uBA74 \uD2F0\uCF13\uC744 \uC18C\uBAA8\uD574 \uBCF4\uC2A4\uC804\uC774
      \uC2DC\uC791\uB429\uB2C8\uB2E4."
    highlightTargetName: Boss_Btn
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 30
    id: open_player
    bodyText: "<b>\uC778\uAC8C\uC784 UI</b> \uC124\uBA85\uC744 \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4.
      <b>\uB098\uB9CC\uC758 \uBD89\uC740 \uD0F1\uD06C\uB97C \uD0A4\uC6CC \uC804\uC7A5\uC744
      \uB3CC\uD30C\uD558\uC138\uC694!</b>"
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 31
    id: base_popup_intro
    bodyText: "<b>\uAE30\uC9C0</b>\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!
      \uC774\uACF3\uC5D0\uC11C\uB294 \uC790\uC6D0\uC744 \uBAA8\uC73C\uACE0 \uC2DC\uC124\uC744
      \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 32
    id: base_popup_intro
    bodyText: "\uBA3C\uC800 \uBCF8\uBD80\uBD80\uD130 \uB458\uB7EC\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      <b>\uC0AC\uB839\uBD80</b>\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Command Center
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 33
    id: base_command_center_intro
    bodyText: "<b>\uAE30\uC9C0 \uC804\uCCB4\uB97C \uCD1D\uAD04\uD558\uB294 \uD575\uC2EC
      \uC2DC\uC124</b>\uC785\uB2C8\uB2E4. \uC0AC\uB839\uBD80 \uB808\uBCA8\uC774 \uC624\uB974\uBA74
      \uC0C8\uB85C\uC6B4 \uC2DC\uC124\uACFC \uCF58\uD150\uCE20\uAC00 \uD574\uAE08\uB429\uB2C8\uB2E4."
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 34
    id: base_command_center_intro
    bodyText: "\uC9C0\uAE08\uC740 \uC77C\uBD80 \uAE30\uC9C0\uAC00 \uC7A0\uACA8 \uC788\uC2B5\uB2C8\uB2E4.
      \uD574\uAE08\uD558\uB824\uBA74 <b>\uC5C5\uADF8\uB808\uC774\uB4DC \uBC84\uD2BC</b>\uC744
      \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Upgrade_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 35
    id: base_command_center_intro
    bodyText: "<b>\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC</b>\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton_Cmd
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 36
    id: base_refinery_intro
    bodyText: "<b>\uC790\uC6D0 \uC815\uC81C\uC18C</b>\uC785\uB2C8\uB2E4. \uC2DC\uAC04\uC774
      \uC9C0\uB0A0\uC218\uB85D \uD06C\uB808\uB527\uC774 \uC313\uC785\uB2C8\uB2E4."
    highlightTargetName: Credit Refinery
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 37
    id: base_refinery_intro
    bodyText: "\uAC00\uB4DD \uCC28\uAE30 \uC804\uC5D0 \uC218\uC9D1\uD574 \uC8FC\uC138\uC694."
    highlightTargetName: Collection_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 38
    id: base_refinery_intro
    bodyText: "\uC774\uBC88\uC5D4 \uC548\uC744 \uC790\uC138\uD788 \uC0B4\uD3B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      <b>\uC790\uC6D0 \uC815\uC81C\uC18C</b>\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Credit Refinery
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 39
    id: base_refinery_intro
    bodyText: "<b>\uD06C\uB808\uB527\uC758 \uC6D0\uB8CC\uAC00 \uB418\uB294 \uAD11\uBB3C\uC744
      \uCC44\uAD74\uD558\uACE0 \uC815\uC81C\uD558\uB294 \uC2DC\uC124</b>\uC785\uB2C8\uB2E4.
      \uCD5C\uB300 \uC800\uC7A5\uB7C9\uACFC \uC2DC\uAC04\uB2F9 \uC218\uC9D1\uB7C9\uC744
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 40
    id: base_refinery_intro
    bodyText: "\uC5C5\uADF8\uB808\uC774\uB4DC\uD560\uC218\uB85D <b>\uB354 \uBE60\uB974\uAC8C,
      \uB354 \uB9CE\uC774</b> \uD06C\uB808\uB527\uC744 \uBAA8\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
